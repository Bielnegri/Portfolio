---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import "../styles/summary.css";

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentLang = getLangFromUrl(Astro.url);
const t = useTranslations(currentLang);

const fileNameMap = {
  pt: "Curriculo_Gabriel_Benedito_PT.pdf",
  en: "Resume_Gabriel_Benedito_EN.pdf",
  es: "Curriculum_Gabriel_Benedito_ES.pdf",
}

const downloadFileName = fileNameMap[currentLang] || fileNameMap["pt"]
---

<section id="summary" class="summary">
    <div class="profile-pic-container">
        <div class="profile-pic-bg">
            <img class="profile-pic" src="/Portfolio/pfp.jpeg">
        </div>
    </div>
    <div class="text-container">
        <h1>{t("summary.intro")} Gabriel Benedito de Negri!</h1>
        <h2>{t("summary.jobTitle")}</h2>
        <p>{t("summary.loc")}</p>
        <p>{t("summary.content")}</p>
    </div>
    <div class="resume-container">
        <h1>{t("resume.title")}</h1>
        <p>{t("resume.content")}</p>
        <a download={downloadFileName} href={`${baseUrl}/cv-${currentLang}.pdf`}>{t("resume.download")}<img class="button-img" src="/Portfolio/download.png"></a>
        <!-- Adicionar os arquivos de cv para ingles e espanhol -->
    </div>
</section>