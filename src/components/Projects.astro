        technologies={[
            { src: "/Portfolio/javascript-original.svg", alt: "JavaScript" },
            { src: "/Portfolio/nodejs-original.svg", alt: "Node js" },
            { src: "/Portfolio/go-original.svg", alt: "Go" },
