            { src: "/Portfolio/css3-original.svg", alt: "CSS3" },
            { src: "/Portfolio/typescript-original.svg", alt: "TypeScript" },
            { src: "/Portfolio/mysql-original.svg", alt: "MySQL" },
            { src: "/Portfolio/apache-original.svg", alt: "Apache" }
        ]}
        t={t} lang={lang}
    />
    <ProjectCard 
        projectId="caixa"
        privateProj={false} 
        illustration=""
        about="https://github.com/Bielnegri/CaixaEletronicoJava"
        technologies={[
            { src: "/Portfolio/java-original.svg", alt: "Java" }
        ]}
        t={t} lang={lang}
    />
    <ProjectCard 
        projectId="mods"
        privateProj={true}
        illustration=""
