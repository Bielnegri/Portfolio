---
import type { TranslationFunction, Lang } from '../i18n/utils'
import type { ui } from "../i18n/ui";
import "../styles/project_card.css";

interface Props {
  projectId: string;
  t: TranslationFunction;
  lang: Lang;
}

const { projectId, t, lang} = Astro.props;

const titleKey = `projects.${projectId}.title` as keyof typeof ui[typeof lang];
const descKey = `projects.${projectId}.description` as keyof typeof ui[typeof lang];
---

<div class="project-container">
    <div class="illustration-container">
        <div class="illustration-bg">
            <img class="illustration" src="" alt="" />
        </div>
    </div>
    <div class="info-container">
        <h1>{t(titleKey)}</h1>
        <div class="description">
            <p>{t(descKey)}</p>
            <a href="#">{t("projects.about")}</a>
        </div>
        <div class="technologies">
            <img src="/Portfolio/html5-original.svg" alt="HTML5" />
            <img src="/Portfolio/css3-original.svg" alt="CSS3" />
            <img src="/Portfolio/javascript-original.svg" alt="JavaScript" />
            <img src="/Portfolio/php-original.svg" alt="PHP" />
            <img src="/Portfolio/mysql-original.svg" alt="MySQL" />
        </div>
    </div>
</div>