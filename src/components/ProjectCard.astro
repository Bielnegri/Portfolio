---
import type { TranslationFunction, Lang } from '../i18n/utils'
import type { ui } from "../i18n/ui";
import "../styles/project_card.css";

interface Props {
    projectId: string;
    privateProj : boolean;
    illustration : string;
    about : string;
    technologies : { src: string; alt: string }[];
    t: TranslationFunction;
    lang: Lang;
}

const { projectId, privateProj, illustration, about, technologies, t, lang} = Astro.props;

const titleKey = `projects.${projectId}.title` as keyof typeof ui[typeof lang];
const descKey = `projects.${projectId}.description` as keyof typeof ui[typeof lang];
---

<div class="project-container">
    <div class="illustration-container">
        <div class="illustration-bg">
            <img class="illustration" src={illustration} alt={t(titleKey)} />
        </div>
    </div>
    <div class="info-container">
        <h1>{t(titleKey)}</h1>
        <div class="description">
            <p>{t(descKey)}</p>
            {!privateProj && <a href={about} target="_blank">{t("projects.about")}</a>}
        </div>
        <div class="technologies">
            {technologies.map((tech) => (
                <img src={tech.src} alt={tech.alt} />
            ))}
        </div>
    </div>
</div>