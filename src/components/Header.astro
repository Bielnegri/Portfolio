---
import { getTargetUrl } from '../i18n/utils';
import type { TranslationFunction, Lang } from '../i18n/utils'
import '../styles/header.css';

interface Props {
    t: TranslationFunction;
    lang: Lang;
}

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;
const { t, lang } = Astro.props;
---

<header>
    <div class="owner-container">
        <p class="name">Gabriel Benedito de Negri</p>
        <p class="jobTitle">{t("title.jobTitle")}</p>
    </div>
    <div class="tabs-container">
        <a class="tab" href={`${baseUrl}/${lang}#summary`}>{t("tabs.summary")}</a>
        <a class="tab" href={`${baseUrl}/${lang}#projects`}>{t("tabs.projects")}</a>
        <a class="tab" href={`${baseUrl}/${lang}#education`}>{t("tabs.education")}</a>
    </div>
    <div class="contacts-container">
        <a href="https://www.github.com/Bielnegri">
            <img class="icon" src="/Portfolio/github.png" alt="GitHub">
        </a>
        <a href="https://www.linkedin.com/in/gabriel-benedito-de-negri">
            <img class="icon" src="/Portfolio/linkedin.png" alt="Linkedin">
        </a>
        <a href="mailto:gabrielbnegri@gmail.com">
            <img class="icon" src="/Portfolio/enviar.png" alt="Linkedin">
        </a>
    </div>
    <div class="language-container">
        <a href={getTargetUrl(currentPath, lang,'pt')} class:list={[{active: lang === 'pt'}]}>
            <img src="/Portfolio/brazil.png" alt="PT">
        </a>
        <a href={getTargetUrl(currentPath, lang,'en')} class:list={[{active: lang === 'en'}]}>
            <img src="/Portfolio/usa.png" alt="EN">
        </a>
        <a href={getTargetUrl(currentPath, lang,'es')} class:list={[{active: lang === 'es'}]}>
            <img src="/Portfolio/spain.png" alt="ES">
        </a>
    </div>    
</header>